# Required for the first production login.
PLATFORM_ADMIN_USERNAME=admin
# Generate with: node scripts/generate-platform-admin-password.mjs
PLATFORM_ADMIN_PASSWORD_HASH=scrypt$replace-me
# 32 random bytes encoded as 64 hexadecimal characters.
PLATFORM_ENCRYPTION_KEY=replace-with-64-hex-characters
# JSON privado con una entrada por tenant habilitado. No se muestra en la UI.
# Dejar vacío mantiene los backups deshabilitados hasta configurarlo explícitamente.
PLATFORM_BACKUP_DATABASES_JSON=[]
# 0 = solo ejecución manual desde el panel; un valor positivo programa la ejecución.
PLATFORM_BACKUP_INTERVAL_MINUTES=0
PLATFORM_BACKUP_RETENTION_DAILY=14
PLATFORM_BACKUP_RETENTION_WEEKLY=8
PLATFORM_BACKUP_RETENTION_MONTHLY=6
