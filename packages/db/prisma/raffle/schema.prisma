generator client {
  provider      = "prisma-client-js"
  output        = "../../../../node_modules/@prisma/client-raffle"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("RAFFLE_DATABASE_URL")
}

// Unified Settings Table (Raffle Context)
model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String?
  description String?
  group       String   @default("general")
  updated_at  DateTime @default(now()) @map("updated_at")

  @@map("settings")
}

// Raffle Specific Models
model Raffle {
  id                     Int                         @id @default(autoincrement())
  title                  String                      @map("title")
  description            String?                     @map("description")
  ticketPrice            Decimal                     @map("ticket_price")
  ticketQuantity         Int                         @map("ticket_quantity")
  opportunities          Int                         @default(1) @map("opportunities")
  distribution           RaffleDistribution          @default(LINEAR) @map("distribution")
  useZero                Boolean                     @default(false) @map("use_zero")
  digits                 Int                         @default(3) @map("digits")
  drawDate               DateTime?                   @map("draw_date")
  image                  String?                     @map("image")
  imageType              MediaType                   @default(PHOTO) @map("image_type")
  imagePoster            String?                     @map("image_poster")
  whatsappHeaderUrl      String?                     @map("whatsapp_header_url")
  prizeShippingPolicy    RafflePrizeShippingPolicy?  @map("prize_shipping_policy")
  status                 RaffleStatus                @default(ACTIVE) @map("status")
  published              Boolean                     @default(true) @map("published")
  featured               Boolean                     @default(false)
  featuredOrder          Int?                        @map("featured_order")
  winningNumber          String?                     @map("winning_number")
  resultReferenceNumber  String?                     @map("result_reference_number")
  winningTicketNumber    String?                     @map("winning_ticket_number")
  winningParticipationId String?                     @map("winning_participation_id")
  resultResolutionStatus String?                     @map("result_resolution_status")
  resultPublishedAt      DateTime?                   @map("result_published_at")
  participationStartsAt  DateTime?                   @map("participation_starts_at")
  participationEndsAt    DateTime?                   @map("participation_ends_at")
  earlyAccessEnabled     Boolean                     @default(false) @map("early_access_enabled")
  earlyAccessCodeHash    String?                     @map("early_access_code_hash")
  createdAt              DateTime                    @default(now()) @map("created_at")
  gallery                RaffleGallery[]
  extraOpportunities     RaffleOpportunity[]
  ticketSales            TicketSale[]
  paymentHolds           RafflePaymentHold[]
  coupons                RaffleCoupon[]
  openingSubscriptions   RaffleOpeningSubscription[]
  prizes                 RafflePrize[]
  participationEvents    RaffleParticipationEvent[]
  resultEvents           RaffleResultEvent[]
  resultCampaigns        RaffleResultCampaign[]
  drawReminderCampaigns  RaffleDrawReminderCampaign[]
  invitationCampaigns    RaffleInvitationCampaign[]
  participationAccessTokens RaffleParticipationAccessToken[]
  participationLookupChallenges RaffleParticipationLookupChallenge[]

  @@index([featured, featuredOrder])
  @@index([resultPublishedAt])
  @@map("raffles")
}

model RaffleResultEvent {
  id            Int      @id @default(autoincrement())
  raffleId      Int      @map("raffle_id")
  eventType     String   @map("event_type")
  message       String?
  actorType     String   @default("SYSTEM") @map("actor_type")
  actorUserId   Int?     @map("actor_user_id")
  actorName     String?  @map("actor_name")
  actorRole     String?  @map("actor_role")
  origin        String   @default("SYSTEM")
  previousState Json?    @map("previous_state")
  nextState     Json?    @map("next_state")
  metadata      Json?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  requestId     String?  @map("request_id")
  createdAt     DateTime @default(now()) @map("created_at")
  raffle        Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@index([raffleId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("raffle_result_events")
}

model RaffleParticipationEvent {
  id              Int      @id @default(autoincrement())
  participationId String   @map("participation_id")
  raffleId        Int      @map("raffle_id")
  eventType       String   @map("event_type")
  message         String?
  actorType       String   @default("SYSTEM") @map("actor_type")
  actorUserId     Int?     @map("actor_user_id")
  actorName       String?  @map("actor_name")
  actorRole       String?  @map("actor_role")
  origin          String   @default("SYSTEM")
  previousState   Json?    @map("previous_state")
  nextState       Json?    @map("next_state")
  metadata        Json?
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  requestId       String?  @map("request_id")
  createdAt       DateTime @default(now()) @map("created_at")
  raffle          Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@index([participationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("raffle_participation_events")
}

model RaffleAudience {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  rules           Json
  active          Boolean  @default(true)
  createdByUserId Int?     @map("created_by_user_id")
  createdByName   String?  @map("created_by_name")
  createdByRole   String?  @map("created_by_role")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  invitationCampaigns RaffleInvitationCampaign[]

  @@index([active, updatedAt])
  @@map("raffle_audiences")
}

model RafflePrize {
  id                     Int                           @id @default(autoincrement())
  raffleId               Int                           @map("raffle_id")
  position               Int
  title                  String
  description            String
  winnerRule             String?                       @map("winner_rule")
  resultSource           String                        @default("MAJOR_PRIZE") @map("result_source")
  resultSourceLabel      String?                       @map("result_source_label")
  draftReferenceNumber   String?                       @map("draft_reference_number")
  resultReferenceNumber  String?                       @map("result_reference_number")
  winningNumber          String?                       @map("winning_number")
  winningTicketNumber    String?                       @map("winning_ticket_number")
  winningParticipationId String?                       @map("winning_participation_id")
  resultResolutionStatus String?                       @map("result_resolution_status")
  resultPublishedAt      DateTime?                     @map("result_published_at")
  fulfillmentStatus      RafflePrizeFulfillmentStatus? @map("fulfillment_status")
  fulfillmentUpdatedAt   DateTime?                     @map("fulfillment_updated_at")
  fulfillmentUpdatedBy   Int?                          @map("fulfillment_updated_by")
  fulfillmentNotes       String?                       @map("fulfillment_notes")
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")
  raffle                 Raffle                        @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, position])
  @@index([raffleId, position])
  @@index([raffleId, resultPublishedAt])
  @@map("raffle_prizes")
}

model RaffleResultCampaign {
  id                       String                       @id @default(uuid()) @db.Uuid
  raffleId                 Int                          @map("raffle_id")
  audience                 RaffleResultCampaignAudience
  status                   RaffleResultCampaignStatus   @default(QUEUED)
  resultPublishedAt        DateTime                     @map("result_published_at")
  templateContent          String                       @map("template_content")
  principalTemplateContent String                       @map("principal_template_content")
  totalRecipients          Int                          @default(0) @map("total_recipients")
  sentCount                Int                          @default(0) @map("sent_count")
  failedCount              Int                          @default(0) @map("failed_count")
  initiatedByUserId        Int?                         @map("initiated_by_user_id")
  initiatedByName          String?                      @map("initiated_by_name")
  initiatedByRole          String?                      @map("initiated_by_role")
  completedAt              DateTime?                    @map("completed_at")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  raffle                   Raffle                       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  recipients               RaffleResultRecipient[]

  @@unique([raffleId, audience, resultPublishedAt])
  @@index([raffleId, createdAt])
  @@map("raffle_result_campaigns")
}

model RaffleResultRecipient {
  id               String                      @id @default(uuid()) @db.Uuid
  campaignId       String                      @map("campaign_id") @db.Uuid
  phone            String
  customerName     String                      @map("customer_name")
  participationIds String[]                    @default([]) @map("participation_ids")
  payload          Json
  status           RaffleResultRecipientStatus @default(PENDING)
  attempts         Int                         @default(0)
  lastError        String?                     @map("last_error")
  messageLogId     Int?                        @map("message_log_id")
  sentAt           DateTime?                   @map("sent_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  campaign         RaffleResultCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@map("raffle_result_recipients")
}

model RaffleDrawReminderCampaign {
  id                       String                       @id @default(uuid()) @db.Uuid
  raffleId                 Int                          @map("raffle_id")
  drawDate                 DateTime                     @map("draw_date")
  kind                     RaffleCommunicationKind     @default(DRAW_REMINDER)
  previousDrawDate         DateTime?                    @map("previous_draw_date")
  status                   RaffleResultCampaignStatus   @default(QUEUED)
  templateContent          String                       @map("template_content")
  principalTemplateContent String                       @map("principal_template_content")
  totalRecipients          Int                          @default(0) @map("total_recipients")
  sentCount                Int                          @default(0) @map("sent_count")
  failedCount              Int                          @default(0) @map("failed_count")
  scheduledFor             DateTime?                    @map("scheduled_for")
  initiatedByUserId        Int?                         @map("initiated_by_user_id")
  initiatedByName          String?                      @map("initiated_by_name")
  initiatedByRole          String?                      @map("initiated_by_role")
  completedAt              DateTime?                    @map("completed_at")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  raffle                   Raffle                       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  recipients               RaffleDrawReminderRecipient[]

  @@unique([raffleId, drawDate, kind])
  @@index([raffleId, createdAt])
  @@map("raffle_draw_reminder_campaigns")
}

enum RaffleCommunicationKind {
  DRAW_REMINDER
  DATE_CHANGE
}

model RaffleDrawReminderRecipient {
  id               String                      @id @default(uuid()) @db.Uuid
  campaignId       String                      @map("campaign_id") @db.Uuid
  phone            String
  customerName     String                      @map("customer_name")
  participationIds String[]                    @default([]) @map("participation_ids")
  payload          Json
  status           RaffleResultRecipientStatus @default(PENDING)
  attempts         Int                         @default(0)
  lastError        String?                     @map("last_error")
  messageLogId     Int?                        @map("message_log_id")
  sentAt           DateTime?                   @map("sent_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  campaign         RaffleDrawReminderCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@map("raffle_draw_reminder_recipients")
}

model RaffleInvitationCampaign {
  id                       String                       @id @default(uuid()) @db.Uuid
  raffleId                 Int                          @map("raffle_id")
  audienceId               String?                      @map("audience_id") @db.Uuid
  audienceName             String                       @map("audience_name")
  audienceRules            Json                         @map("audience_rules")
  frequencyWindowDays      Int                          @default(30) @map("frequency_window_days")
  status                   RaffleResultCampaignStatus   @default(QUEUED)
  templateContent          String                       @map("template_content")
  principalTemplateContent String                       @map("principal_template_content")
  totalRecipients          Int                          @default(0) @map("total_recipients")
  sentCount                Int                          @default(0) @map("sent_count")
  failedCount              Int                          @default(0) @map("failed_count")
  initiatedByUserId        Int?                         @map("initiated_by_user_id")
  initiatedByName          String?                      @map("initiated_by_name")
  initiatedByRole          String?                      @map("initiated_by_role")
  completedAt              DateTime?                    @map("completed_at")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  raffle                   Raffle                       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  audience                 RaffleAudience?              @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  recipients               RaffleInvitationRecipient[]

  @@index([raffleId, createdAt])
  @@index([audienceId, createdAt])
  @@map("raffle_invitation_campaigns")
}

model RaffleInvitationRecipient {
  id           String                      @id @default(uuid()) @db.Uuid
  campaignId   String                      @map("campaign_id") @db.Uuid
  phone        String
  customerName String                      @map("customer_name")
  payload      Json
  status       RaffleResultRecipientStatus @default(PENDING)
  attempts     Int                         @default(0)
  lastError    String?                     @map("last_error")
  messageLogId Int?                        @map("message_log_id")
  sentAt       DateTime?                   @map("sent_at")
  createdAt    DateTime                    @default(now()) @map("created_at")
  updatedAt    DateTime                    @updatedAt @map("updated_at")
  campaign     RaffleInvitationCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@map("raffle_invitation_recipients")
}

enum RaffleResultCampaignAudience {
  WINNERS
  PARTICIPANTS
}

enum RaffleResultCampaignStatus {
  QUEUED
  PROCESSING
  PARTIAL
  SENT
  FAILED
  EMPTY
}

enum RaffleResultRecipientStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum RafflePrizeFulfillmentStatus {
  PENDING_CONTACT
  CONTACTED
  DELIVERY_COORDINATED
  DELIVERED
  NOT_CLAIMED
  NOT_APPLICABLE
}

enum RaffleDistribution {
  LINEAR @map("linear")
  RANDOM @map("random")
}

enum RafflePrizeShippingPolicy {
  INCLUDED    @map("included")
  WINNER_PAYS @map("winner_pays")
}

enum RaffleStatus {
  ACTIVE    @map("active")
  FINISHED  @map("finished")
  CANCELLED @map("cancelled")
}

model RaffleOpeningSubscription {
  id        String                          @id @default(uuid())
  raffleId  Int                             @map("raffle_id")
  phone     String
  status    RaffleOpeningSubscriptionStatus @default(PENDING)
  consentAt DateTime                        @default(now()) @map("consent_at")
  sentAt    DateTime?                       @map("sent_at")
  attempts  Int                             @default(0)
  lastError String?                         @map("last_error")
  messageLogId Int?                         @map("message_log_id")
  createdAt DateTime                        @default(now()) @map("created_at")
  updatedAt DateTime                        @updatedAt @map("updated_at")
  raffle    Raffle                          @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, phone])
  @@index([status, raffleId])
  @@map("raffle_opening_subscriptions")
}

enum RaffleOpeningSubscriptionStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  SENT       @map("sent")
  FAILED     @map("failed")
  CANCELLED  @map("cancelled")
}

model RaffleGallery {
  id         Int       @id @default(autoincrement())
  raffleId   Int       @map("raffle_id")
  filePath   String    @map("file_path")
  fileType   MediaType @default(PHOTO) @map("file_type")
  posterPath String?   @map("poster_path")
  createdAt  DateTime  @default(now()) @map("created_at")
  raffle     Raffle    @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@map("raffle_gallery")
}

enum MediaType {
  PHOTO @map("photo")
  VIDEO @map("video")
}

model RaffleOpportunity {
  id                 Int    @id @default(autoincrement())
  raffleId           Int    @map("raffle_id")
  mainTicketNumber   String @map("main_ticket_number")
  extraOpportunities Json   @map("extra_opportunities")
  raffle             Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, mainTicketNumber], map: "raffle_opportunities_raffle_main_ticket_key")
  @@map("raffle_opportunities")
}

model TicketSale {
  id                    Int           @id @default(autoincrement())
  raffleId              Int           @map("raffle_id")
  ticketNumber          String        @map("ticket_number")
  customerName          String        @map("customer_name")
  customerPhone         String        @map("customer_phone")
  customerState         String?       @map("customer_state")
  reservationId         String?       @map("reservation_id")
  paymentStatus         TicketStatus  @default(PENDING) @map("payment_status")
  paymentMethod         String?       @map("payment_method")
  mpPaymentId           String?       @map("mp_payment_id")
  mpSellerUserId        String?       @map("mp_seller_user_id")
  mpPaymentStatus       String?       @map("mp_payment_status")
  mpPaymentStatusDetail String?       @map("mp_payment_status_detail")
  mpPaymentMethodId     String?       @map("mp_payment_method_id")
  mpPaymentTypeId       String?       @map("mp_payment_type_id")
  mpPaidAmount          Decimal?      @map("mp_paid_amount")
  mpRefundId            String?       @map("mp_refund_id")
  mpRefundedAmount      Decimal?      @map("mp_refunded_amount")
  mpRefundedAt          DateTime?     @map("mp_refunded_at")
  couponId              Int?          @map("coupon_id")
  couponCode            String?       @map("coupon_code")
  discountTotal         Decimal       @default(0.00) @map("discount_total")
  createdAt             DateTime      @default(now()) @map("created_at")
  raffle                Raffle        @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  coupon                RaffleCoupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([couponId])
  @@index([mpPaymentId])
  @@map("ticket_sales")
}

model RaffleParticipationAccessToken {
  id        String   @id @default(uuid()) @db.Uuid
  raffleId  Int      @map("raffle_id")
  participationId String @map("participation_id")
  phoneHash String   @map("phone_hash")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  raffle    Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@index([raffleId, phoneHash])
  @@index([raffleId, participationId])
  @@index([raffleId, expiresAt])
  @@map("raffle_participation_access_tokens")
}

model RaffleParticipationLookupChallenge {
  id          String   @id @default(uuid()) @db.Uuid
  raffleId    Int      @map("raffle_id")
  phoneHash   String   @map("phone_hash")
  codeHash    String   @map("code_hash")
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  raffle      Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@index([raffleId, phoneHash, expiresAt])
  @@index([expiresAt])
  @@map("raffle_participation_lookup_challenges")
}

model RafflePaymentHold {
  id                    String                    @id @default(uuid()) @db.Uuid
  raffleId              Int                       @map("raffle_id")
  customerName          String                    @map("customer_name")
  customerPhone         String                    @map("customer_phone")
  customerState         String?                   @map("customer_state")
  couponId              Int?                      @map("coupon_id")
  couponCode            String?                   @map("coupon_code")
  discountTotal         Decimal                   @default(0.00) @map("discount_total")
  ticketNumbers         String[]                  @default([]) @map("ticket_numbers")
  status                PaymentHoldStatus         @default(ACTIVE)
  expiresAt             DateTime                  @map("expires_at")
  promotedReservationId String?                   @unique @map("promoted_reservation_id")
  mpPaymentId           String?                   @map("mp_payment_id")
  mpSellerUserId        String?                   @map("mp_seller_user_id")
  mpPaymentStatus       String?                   @map("mp_payment_status")
  mpPaymentStatusDetail String?                   @map("mp_payment_status_detail")
  recoveryTokenHash     String?                   @unique @map("recovery_token_hash")
  recoveryScheduledAt   DateTime?                 @map("recovery_scheduled_at")
  recoverySentAt        DateTime?                 @map("recovery_sent_at")
  recoveryMessageLogId  Int?                      @map("recovery_message_log_id")
  recoveryOpenedAt      DateTime?                 @map("recovery_opened_at")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  raffle                Raffle                    @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  coupon                RaffleCoupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  tickets               RafflePaymentHoldTicket[]
  paymentAttempts       RafflePaymentAttempt[]

  @@index([raffleId, status, expiresAt])
  @@index([mpPaymentId])
  @@map("raffle_payment_holds")
}

model RafflePaymentHoldTicket {
  id           Int               @id @default(autoincrement())
  holdId       String            @map("hold_id") @db.Uuid
  raffleId     Int               @map("raffle_id")
  ticketNumber String            @map("ticket_number")
  hold         RafflePaymentHold @relation(fields: [holdId], references: [id], onDelete: Cascade)

  @@unique([raffleId, ticketNumber])
  @@index([holdId])
  @@map("raffle_payment_hold_tickets")
}

model RafflePaymentAttempt {
  id              String             @id @db.Uuid
  raffleId        Int                @map("raffle_id")
  reservationId   String?            @map("reservation_id")
  holdId          String?            @map("hold_id") @db.Uuid
  idempotencyKey  String             @unique @map("idempotency_key")
  status          String             @default("INITIATED")
  statusDetail    String?            @map("status_detail")
  mpPaymentId     String?            @map("mp_payment_id")
  retryable       Boolean            @default(false)
  uncertain       Boolean            @default(false)
  customerMessage String?            @map("customer_message")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  hold            RafflePaymentHold? @relation(fields: [holdId], references: [id], onDelete: Cascade)

  @@index([raffleId, reservationId, createdAt])
  @@index([holdId, createdAt])
  @@index([mpPaymentId])
  @@map("raffle_payment_attempts")
}

model RaffleCoupon {
  id            Int                      @id @default(autoincrement())
  code          String                   @unique
  name          String?
  discountType  RaffleCouponDiscountType @map("discount_type")
  discountValue Decimal                  @map("discount_value")
  raffleId      Int?                     @map("raffle_id")
  minTickets    Int?                     @map("min_tickets")
  maxDiscount   Decimal?                 @map("max_discount")
  usageLimit    Int?                     @map("usage_limit")
  usedCount     Int                      @default(0) @map("used_count")
  active        Boolean                  @default(true)
  startsAt      DateTime?                @map("starts_at")
  expiresAt     DateTime?                @map("expires_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  raffle        Raffle?                  @relation(fields: [raffleId], references: [id], onDelete: SetNull)
  ticketSales   TicketSale[]
  paymentHolds  RafflePaymentHold[]

  @@index([raffleId, active])
  @@map("raffle_coupons")
}

enum RaffleCouponDiscountType {
  PERCENTAGE @map("percentage")
