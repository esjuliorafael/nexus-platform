  amount         Decimal   @map("amount")
  concept        String    @map("concept")
  contractDate   DateTime? @map("contract_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  description    String?   @map("description")
  displayOrder   Int       @default(0) @map("display_order")
  expirationDate DateTime? @map("expiration_date")
  iconType       String    @default("default") @map("icon_type")
  isPaid         Boolean   @default(false) @map("is_paid")

  @@map("annual_services")
}

model BillingPayment {
  id           Int      @id @default(autoincrement())
  amount       Decimal  @map("amount")
  paymentDate  DateTime @default(now()) @map("payment_date")
  concept      String   @map("concept")
  notes        String?  @map("notes")
  createdAt    DateTime @default(now()) @map("created_at")
  displayOrder Int      @default(0) @map("display_order")

  @@map("billing_payments")
}

model WhatsappMessageLog {
  id              Int              @id @default(autoincrement())
  attempt         Int              @default(1) @map("attempt")
  status          String           @map("status")
  errorMessage    String?          @map("error_message")
  instanceName    String           @map("instance_name")
  jobId           String?          @map("job_id")
  lastStatusAt    DateTime?        @map("last_status_at")
  messageId       String?          @map("message_id")
  orderId         String?          @map("order_id")
  providerStatus  String?          @map("provider_status")
  provider        WhatsappProvider @default(EVOLUTION)
  responsePayload Json?            @map("response_payload")
  recipientPhone  String           @map("recipient_phone")
  sentAt          DateTime         @default(now()) @map("sent_at")
  templateUsed    String           @map("template_used")
  ticketSaleId    Int?             @map("ticket_sale_id")

  @@map("whatsapp_message_logs")
}

model WhatsappCustomerServiceWindow {
  id                     Int              @id @default(autoincrement())
  recipientPhone         String           @map("recipient_phone")
  channelIdentity        String           @map("channel_identity")
  provider               WhatsappProvider @default(KAPSO)
  lastInboundMessageId   String?          @map("last_inbound_message_id")
  openedAt               DateTime         @default(now()) @map("opened_at")
  expiresAt              DateTime         @map("expires_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  @@unique([recipientPhone, channelIdentity, provider])
  @@index([provider, channelIdentity, expiresAt])
  @@map("whatsapp_customer_service_windows")
}

model WhatsappMarketingPreference {
  id              Int                              @id @default(autoincrement())
  phone           String                           @unique
  displayName     String?                          @map("display_name")
  status          WhatsappMarketingConsentStatus   @default(UNKNOWN)
  consentAt       DateTime?                        @map("consent_at")
  consentSource   WhatsappMarketingConsentSource?  @map("consent_source")
  consentVersion  String?                          @map("consent_version")
  optedOutAt      DateTime?                        @map("opted_out_at")
  lastMarketingAt DateTime?                        @map("last_marketing_at")
  createdAt       DateTime                         @default(now()) @map("created_at")
  updatedAt       DateTime                         @updatedAt @map("updated_at")
  events          WhatsappMarketingConsentEvent[]

  @@index([status])
  @@map("whatsapp_marketing_preferences")
}

model WhatsappMarketingConsentEvent {
  id             Int                              @id @default(autoincrement())
  preferenceId   Int                              @map("preference_id")
  previousStatus WhatsappMarketingConsentStatus?  @map("previous_status")
  nextStatus     WhatsappMarketingConsentStatus   @map("next_status")
  source         WhatsappMarketingConsentSource
  policyVersion  String?                          @map("policy_version")
  keyword        String?
  externalEventId String?                         @unique @map("external_event_id")
  metadata       Json?
  createdAt      DateTime                         @default(now()) @map("created_at")
  preference     WhatsappMarketingPreference      @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@index([preferenceId, createdAt])
  @@map("whatsapp_marketing_consent_events")
}

