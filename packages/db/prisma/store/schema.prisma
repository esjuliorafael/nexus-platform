generator client {
  provider      = "prisma-client-js"
  output        = "../../../../node_modules/@prisma/client-store"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String?
  description String?
  group       String   @default("general")
  updated_at  DateTime @default(now()) @map("updated_at")

  @@map("settings")
}

model User {
  id                   Int              @id @default(autoincrement())
  username             String           @unique
  passwordHash         String           @map("password_hash")
  name                 String
  email                String?
  phone                String?
  role                 Role             @default(STAFF)
  active               Boolean          @default(true)
  createdAt            DateTime         @default(now()) @map("created_at")
  notificationEmail    String?          @map("notification_email")
  receiveNotifications Boolean          @default(true) @map("receive_notifications")
  mustChangePassword   Boolean          @default(true) @map("must_change_password")
  orderReads           OrderRead[]
  orderEvents          OrderEvent[]
  productEvents        ProductEvent[]
  contactProfile       ContactProfile?
  mediaVaultItems      MediaVaultItem[]

  @@map("users")
}

model ContactProfile {
  id             Int              @id @default(autoincrement())
  userId         Int              @unique @map("user_id")
  displayName    String?          @map("display_name")
  responsibility String
  description    String?
  scheduleText   String?          @map("schedule_text")
  published      Boolean          @default(false)
  sortOrder      Int              @default(0) @map("sort_order")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  channels       ContactChannel[]

  @@index([published, sortOrder])
  @@map("contact_profiles")
}

model ContactChannel {
  id               Int                @id @default(autoincrement())
  contactProfileId Int                @map("contact_profile_id")
  type             ContactChannelType
  phoneNumber      String             @map("phone_number")
  label            String?
  active           Boolean            @default(true)
  sortOrder        Int                @default(0) @map("sort_order")
  contactProfile   ContactProfile     @relation(fields: [contactProfileId], references: [id], onDelete: Cascade)

  @@unique([contactProfileId, type, phoneNumber])
  @@index([contactProfileId, active, sortOrder])
  @@map("contact_channels")
}

model Category {
  id            Int           @id @default(autoincrement())
  active        Boolean       @default(true) @map("active")
  createdAt     DateTime      @default(now()) @map("created_at")
  icon          String?       @map("icon")
  name          String        @map("name")
  media         Media[]
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id         Int                @id @default(autoincrement())
  active     Boolean            @default(true) @map("active")
  categoryId Int                @map("category_id")
  name       String             @map("name")
  mediaLinks MediaSubcategory[]
  category   Category           @relation(fields: [categoryId], references: [id])

  @@map("subcategories")
}

model Product {
  id               Int                    @id @default(autoincrement())
  stock            Int                    @default(1)
  active           Boolean                @default(true) @map("active")
  published        Boolean                @default(true) @map("published")
  createdAt        DateTime               @default(now()) @map("created_at")
  description      String?                @map("description")
  name             String                 @map("name")
  price            Decimal                @default(0.00) @map("price")
  ringNumber       String?                @map("ring_number")
  saleStatus       SaleStatus             @default(AVAILABLE) @map("sale_status")
  coverAssetId     String?                @map("cover_asset_id") @db.Uuid
  type             ProductType            @map("type")
  featured         Boolean                @default(false) @map("featured")
  featuredOrder    Int?                   @map("featured_order")
  updated_at       DateTime               @default(now()) @map("updated_at")
  age              BirdAge?               @map("age")
  purpose          BirdPurpose?           @map("purpose")
  orderItems       OrderItem[]
  events           ProductEvent[]
  paymentHoldItems StorePaymentHoldItem[]
  inventoryIntegrityIncidents InventoryIntegrityIncident[]
  gallery          ProductGallery[]
  coverAsset       MediaAsset?            @relation("ProductCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)

  @@index([coverAssetId])
  @@index([active, published])
  @@index([type, featured, featuredOrder])
  @@map("products")
}

model StoreHero {
  id                    Int            @id @default(autoincrement())
  scope                 StoreHeroScope @map("scope")
  assetId               String         @map("asset_id") @db.Uuid
  desktopObjectPosition String         @default("50% 50%") @map("desktop_object_position")
  mobileObjectPosition  String         @default("50% 50%") @map("mobile_object_position")
  title                 String         @map("title")
  description           String?        @map("description")
  sortOrder             Int            @default(1) @map("sort_order")
  active                Boolean        @default(true) @map("active")
  startsAt              DateTime?      @map("starts_at")
  endsAt                DateTime?      @map("ends_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  asset                 MediaAsset     @relation(fields: [assetId], references: [id])

  @@unique([scope, sortOrder])
  @@index([assetId])
  @@index([scope, active, sortOrder])
  @@map("store_heroes")
}

model StorefrontAnnouncement {
  id           Int                             @id @default(autoincrement())
  scope        StorefrontAnnouncementScope
  targetId     Int?                            @map("target_id")
  presentation StorefrontAnnouncementDisplay   @default(POPUP)
  variant      StorefrontAnnouncementVariant   @default(INFO)
  frequency    StorefrontAnnouncementFrequency @default(ONCE_VISITOR)
  eyebrow      String?
  title        String
  message      String
  ctaLabel     String?                         @map("cta_label")
  ctaHref      String?                         @map("cta_href")
  dismissible  Boolean                         @default(true)
  active       Boolean                         @default(true)
  priority     Int                             @default(0)
  version      Int                             @default(1)
  startsAt     DateTime?                       @map("starts_at")
  endsAt       DateTime?                       @map("ends_at")
  createdAt    DateTime                        @default(now()) @map("created_at")
  updatedAt    DateTime                        @updatedAt @map("updated_at")

  @@index([active, startsAt, endsAt])
  @@index([scope, targetId, priority])
  @@map("storefront_announcements")
}

model ProductGallery {
  id        Int        @id @default(autoincrement())
  assetId   String     @map("asset_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  productId Int        @map("product_id")
  asset     MediaAsset @relation(fields: [assetId], references: [id])
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("product_gallery")
}

model Order {
  id                    Int                   @id @default(autoincrement())
  subtotal              Decimal               @map("subtotal")
  discountTotal         Decimal               @default(0.00) @map("discount_total")
  total                 Decimal               @map("total")
  createdAt             DateTime              @default(now()) @map("created_at")
  customerName          String                @map("customer_name")
  customerPhone         String                @map("customer_phone")
  receiverName          String?               @map("receiver_name")
  deliveryType          DeliveryType          @default(SHIPPING) @map("delivery_type")
  deliveryMethod        String?               @map("delivery_method")
  shippingAddress       String?               @map("shipping_address")
  shippingStreet        String?               @map("shipping_street")
  shippingNeighborhood  String?               @map("shipping_neighborhood")
  shippingPostalCode    String?               @map("shipping_postal_code")
  shippingCity          String?               @map("shipping_city")
  shippingCost          Decimal               @map("shipping_cost")
  shippingState         String?               @map("shipping_state")
  status                OrderStatus           @default(PENDING) @map("status")
  paymentMethod         String                @default("TRANSFER") @map("payment_method")
  paymentStatus         String                @default("PENDING") @map("payment_status")
  paymentExpiresAt      DateTime?             @map("payment_expires_at")
  mpPaymentId           String?               @map("mp_payment_id")
  mpSellerUserId        String?               @map("mp_seller_user_id")
  mpPaymentStatus       String?               @map("mp_payment_status")
  mpPaymentStatusDetail String?               @map("mp_payment_status_detail")
  mpPaymentMethodId     String?               @map("mp_payment_method_id")
  mpPaymentTypeId       String?               @map("mp_payment_type_id")
  mpPaidAmount          Decimal?              @map("mp_paid_amount")
  mpRefundId            String?               @map("mp_refund_id")
  mpRefundedAmount      Decimal               @default(0.00) @map("mp_refunded_amount")
  mpRefundedAt          DateTime?             @map("mp_refunded_at")
  customerEmail         String?               @map("customer_email")
  couponId              Int?                  @map("coupon_id")
  couponCode            String?               @map("coupon_code")
  expiresAt             DateTime?             @map("expires_at")
  coupon                Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  reads                 OrderRead[]
  events                OrderEvent[]
  paymentAttempts       OrderPaymentAttempt[]
  paymentHold           StorePaymentHold?

  @@index([couponId])
  @@map("orders")
}

model StorePaymentHold {
  id                    String                 @id @default(uuid()) @db.Uuid
  customerName          String                 @map("customer_name")
  customerPhone         String                 @map("customer_phone")
  customerEmail         String?                @map("customer_email")
  receiverName          String?                @map("receiver_name")
  deliveryType          DeliveryType           @default(SHIPPING) @map("delivery_type")
  deliveryMethod        String?                @map("delivery_method")
  shippingAddress       String?                @map("shipping_address")
  shippingStreet        String?                @map("shipping_street")
  shippingNeighborhood  String?                @map("shipping_neighborhood")
  shippingPostalCode    String?                @map("shipping_postal_code")
  shippingCity          String?                @map("shipping_city")
  shippingState         String?                @map("shipping_state")
  subtotal              Decimal
  discountTotal         Decimal                @default(0.00) @map("discount_total")
  shippingCost          Decimal                @map("shipping_cost")
  total                 Decimal
  couponId              Int?                   @map("coupon_id")
  couponCode            String?                @map("coupon_code")
  status                PaymentHoldStatus      @default(ACTIVE)
  expiresAt             DateTime               @map("expires_at")
  promotedOrderId       Int?                   @unique @map("promoted_order_id")
  mpPaymentId           String?                @map("mp_payment_id")
  mpSellerUserId        String?                @map("mp_seller_user_id")
  mpPaymentStatus       String?                @map("mp_payment_status")
  mpPaymentStatusDetail String?                @map("mp_payment_status_detail")
  recoveryTokenHash     String?                @unique @map("recovery_token_hash")
  recoveryScheduledAt   DateTime?              @map("recovery_scheduled_at")
  recoverySentAt        DateTime?              @map("recovery_sent_at")
  recoveryOpenedAt      DateTime?              @map("recovery_opened_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  coupon                Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  promotedOrder         Order?                 @relation(fields: [promotedOrderId], references: [id], onDelete: SetNull)
  items                 StorePaymentHoldItem[]
  paymentAttempts       OrderPaymentAttempt[]

  @@index([status, expiresAt])
  @@index([mpPaymentId])
  @@map("store_payment_holds")
}

model StorePaymentHoldItem {
  id          Int              @id @default(autoincrement())
  holdId      String           @map("hold_id") @db.Uuid
  productId   Int              @map("product_id")
  productName String           @map("product_name")
  productType ProductType      @map("product_type")
  quantity    Int
  unitPrice   Decimal          @map("unit_price")
  hold        StorePaymentHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])

  @@index([holdId])
  @@map("store_payment_hold_items")
}

model InventoryIntegrityIncident {
  id               Int       @id @default(autoincrement())
  productId        Int       @map("product_id")
  issueType        String    @map("issue_type")
  status           String    @default("OPEN")
  firstDetectedAt  DateTime  @default(now()) @map("first_detected_at")
  lastDetectedAt   DateTime  @default(now()) @map("last_detected_at")
  resolvedAt       DateTime? @map("resolved_at")
  resolvedByUserId Int?      @map("resolved_by_user_id")
  resolvedByName   String?   @map("resolved_by_name")
  resolution       String?
  snapshot         Json?
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, issueType])
  @@index([status, lastDetectedAt])
  @@map("inventory_integrity_incidents")
}

model OrderPaymentAttempt {
  id              String            @id @db.Uuid
  orderId         Int?              @map("order_id")
  holdId          String?           @map("hold_id") @db.Uuid
  idempotencyKey  String            @unique @map("idempotency_key")
  status          String            @default("INITIATED")
  statusDetail    String?           @map("status_detail")
  mpPaymentId     String?           @map("mp_payment_id")
  retryable       Boolean           @default(false)
  uncertain       Boolean           @default(false)
  customerMessage String?           @map("customer_message")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  hold            StorePaymentHold? @relation(fields: [holdId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([holdId, createdAt])
  @@index([mpPaymentId])
  @@map("order_payment_attempts")
}

model Coupon {
  id            Int                @id @default(autoincrement())
  code          String             @unique @map("code")
  name          String?            @map("name")
  discountType  CouponDiscountType @map("discount_type")
  discountValue Decimal            @map("discount_value")
  scope         CouponScope        @default(ALL) @map("scope")
  minSubtotal   Decimal?           @map("min_subtotal")
  maxDiscount   Decimal?           @map("max_discount")
  usageLimit    Int?               @map("usage_limit")
  usedCount     Int                @default(0) @map("used_count")
  active        Boolean            @default(true) @map("active")
  startsAt      DateTime?          @map("starts_at")
  expiresAt     DateTime?          @map("expires_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  orders        Order[]
  paymentHolds  StorePaymentHold[]

  @@index([active, startsAt, expiresAt])
  @@map("coupons")
}

model OrderRead {
  orderId Int      @map("order_id")
  userId  Int      @map("user_id")
  readAt  DateTime @default(now()) @map("read_at")
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orderId, userId])
  @@index([userId, readAt])
  @@map("order_reads")
}

model OrderEvent {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  eventType     String   @map("event_type")
  message       String?  @map("message")
  actorType     String   @default("SYSTEM") @map("actor_type")
  actorUserId   Int?     @map("actor_user_id")
  actorName     String?  @map("actor_name")
  actorRole     String?  @map("actor_role")
  origin        String   @default("SYSTEM")
  previousState Json?    @map("previous_state")
  nextState     Json?    @map("next_state")
  metadata      Json?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  requestId     String?  @map("request_id")
  createdAt     DateTime @default(now()) @map("created_at")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser     User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("order_events")
}

model ProductEvent {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  eventType     String   @map("event_type")
  message       String?  @map("message")
  actorType     String   @default("SYSTEM") @map("actor_type")
  actorUserId   Int?     @map("actor_user_id")
  actorName     String?  @map("actor_name")
  actorRole     String?  @map("actor_role")
  origin        String   @default("SYSTEM")
  previousState Json?    @map("previous_state")
  nextState     Json?    @map("next_state")
  metadata      Json?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  requestId     String?  @map("request_id")
  createdAt     DateTime @default(now()) @map("created_at")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorUser     User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("product_events")
}

model OrderItem {
  id          Int         @id @default(autoincrement())
  orderId     Int         @map("order_id")
  productId   Int         @map("product_id")
  productName String?     @map("product_name")
  productType ProductType @map("product_type")
  quantity    Int         @map("quantity")
  unitPrice   Decimal     @map("unit_price")
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Media {
  id               Int                @id @default(autoincrement())
  likes            Int                @default(0) @map("likes")
  active           Boolean            @default(true) @map("active")
  categoryId       Int?               @map("category_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  description      String?            @map("description")
  assetId          String             @map("asset_id") @db.Uuid
  location         String?            @map("location")
  mediaDate        DateTime?          @map("media_date")
  title            String             @map("title")
  asset            MediaAsset         @relation(fields: [assetId], references: [id])
  category         Category?          @relation(fields: [categoryId], references: [id])
  subcategoryLinks MediaSubcategory[]

  @@index([assetId])
  @@map("media")
}

model MediaSubcategory {
  mediaId       Int         @map("media_id")
  subcategoryId Int         @map("subcategory_id")
  media         Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@id([mediaId, subcategoryId])
  @@index([subcategoryId, mediaId])
  @@map("media_subcategories")
}

model HomeSlide {
  id                    Int        @id @default(autoincrement())
  active                Boolean    @default(true) @map("active")
  createdAt             DateTime   @default(now()) @map("created_at")
  desktopObjectPosition String     @default("50% 50%") @map("desktop_object_position")
  description           String?    @map("description")
  displayDurationMs     Int        @default(8000) @map("display_duration_ms")
  eyebrow               String?    @map("eyebrow")
  assetId               String     @map("asset_id") @db.Uuid
  mobileObjectPosition  String     @default("50% 44%") @map("mobile_object_position")
  primaryHref           String?    @map("primary_href")
  primaryText           String?    @map("primary_text")
  secondaryHref         String?    @map("secondary_href")
  secondaryText         String?    @map("secondary_text")
  sortOrder             Int        @default(1) @map("sort_order")
  startsAt              DateTime?  @map("starts_at")
  endsAt                DateTime?  @map("ends_at")
  title                 String     @map("title")
  asset                 MediaAsset @relation(fields: [assetId], references: [id])
  updatedAt             DateTime   @updatedAt @map("updated_at")

  @@unique([sortOrder])
  @@index([assetId])
  @@map("home_slides")
}

model MediaAsset {
  id             String           @id @default(uuid()) @db.Uuid
  mediaUrl       String?          @unique @map("media_url")
  posterUrl      String?          @map("poster_url")
  sourceKey      String?          @map("source_key")
  mediaType      MediaType        @map("media_type")
  mimeType       String           @map("mime_type")
  originalName   String?          @map("original_name")
  status         MediaAssetStatus @default(PROCESSING)
  errorMessage   String?          @map("error_message")
  durationMs     Int?             @map("duration_ms")
  width          Int?
  height         Int?
  sizeBytes      Int?             @map("size_bytes")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  coverProducts  Product[]        @relation("ProductCoverAsset")
  productGallery ProductGallery[]
  mediaEntries   Media[]
  homeSlides     HomeSlide[]
  storeHeroes    StoreHero[]
  vaultItem      MediaVaultItem?

  @@index([status, createdAt])
  @@map("media_assets")
}

model MediaVaultItem {
  id             String     @id @default(uuid()) @db.Uuid
  assetId        String     @unique @map("asset_id") @db.Uuid
  uploadedById   Int?       @map("uploaded_by_id")
  uploadedByName String     @map("uploaded_by_name")
  downloadName   String     @map("download_name")
  expiresAt      DateTime   @map("expires_at")
  downloadedAt   DateTime?  @map("downloaded_at")
  downloadCount  Int        @default(0) @map("download_count")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  asset          MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy     User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([uploadedById, createdAt])
  @@map("media_vault_items")
}

model PaymentChannel {
  id                     Int       @id @default(autoincrement())
  clabe                  String?   @map("clabe")
  bank                   String    @map("bank")
  beneficiary            String    @map("beneficiary")
  accountNumber          String?   @map("account_number")
  card                   String?   @map("card")
  createdAt              DateTime  @default(now()) @map("created_at")
  name                   String    @map("name")
  purpose                String    @map("purpose")
  mpAccessToken          String?   @map("mp_access_token")
  mpRefreshToken         String?   @map("mp_refresh_token")
  mpUserId               String?   @map("mp_user_id")
  mpAccessTokenExpiresAt DateTime? @map("mp_access_token_expires_at")

  @@map("payment_channels")
}

model WhatsappChannel {
  id                     Int                     @id @default(autoincrement())
  provider               WhatsappProvider        @default(EVOLUTION)
  deliveryStrategy       WhatsappDeliveryStrategy @default(STANDARD) @map("delivery_strategy")
  evolutionKey           String?                 @map("evolution_key")
  evolutionUrl           String?                 @map("evolution_url")
  kapsoPhoneNumberId     String?                 @map("kapso_phone_number_id")
  kapsoBusinessAccountId String?                 @map("kapso_business_account_id")
  active                 Boolean                 @default(true) @map("active")
  createdAt              DateTime                @default(now()) @map("created_at")
  instanceName           String?                 @map("instance_name")
  name                   String                  @map("name")
  phone                  String                  @map("phone")
  purpose                String                  @map("purpose")
  template               String                  @map("template")
  updated_at             DateTime                @default(now()) @map("updated_at")
  templates              WhatsappTemplate[]
  cloudTemplates         WhatsappCloudTemplate[]
  cloudTemplateCandidates WhatsappCloudTemplateCandidate[]
  kapsoOnboardingSessions KapsoOnboardingSession[]

  @@index([provider, active])
  @@map("whatsapp_channels")
}

model KapsoOnboardingSession {
  id                       String                        @id @default(uuid())
  tokenHash                String                        @unique @map("token_hash")
  customerId               String                        @map("customer_id")
  target                   KapsoOnboardingTarget
  channelId                Int?                          @map("channel_id")
  status                   KapsoOnboardingStatus         @default(PENDING)
  setupLinkId              String?                       @map("setup_link_id")
  phoneNumberId            String?                       @map("phone_number_id")
  businessAccountId        String?                       @map("business_account_id")
  displayPhoneNumber       String?                       @map("display_phone_number")
  returnUrl                String                        @map("return_url")
  errorMessage             String?                       @map("error_message")
  expiresAt                DateTime                      @map("expires_at")
  completedAt              DateTime?                     @map("completed_at")
  createdAt                DateTime                      @default(now()) @map("created_at")
  updatedAt                DateTime                      @updatedAt @map("updated_at")
  channel                  WhatsappChannel?              @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([customerId, status, createdAt])
  @@index([channelId, status])
  @@map("kapso_onboarding_sessions")
}

model WhatsappTemplate {
  id         Int              @id @default(autoincrement())
  channelId  Int?             @map("channel_id")
  type       TemplateType     @map("type")
  content    String           @map("content")
  active     Boolean          @default(true) @map("active")
  createdAt  DateTime         @default(now()) @map("created_at")
  updated_at DateTime         @default(now()) @map("updated_at")
  channel    WhatsappChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, type])
  @@map("whatsapp_templates")
}

model WhatsappCloudTemplate {
  id             Int                        @id @default(autoincrement())
  channelId      Int?                       @map("channel_id")
  ownerKey       String                     @map("owner_key")
  scope          WhatsappCloudTemplateScope
  type           TemplateType
  variant        String                     @default("LEGACY")
  templateName   String                     @map("template_name")
  templateId     String?                    @map("template_id")
  category       String?                    @map("category")
  languageCode   String                     @default("es_MX") @map("language_code")
  status         String                     @default("PENDING")
  parameterNames Json                       @map("parameter_names")
  contentHash    String                     @map("content_hash")
  lastError      String?                    @map("last_error")
  lastSyncedAt   DateTime?                  @map("last_synced_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  channel        WhatsappChannel?           @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([ownerKey, scope, type, variant])
  @@index([channelId, status])
  @@map("whatsapp_cloud_templates")
}

model WhatsappCloudTemplateCandidate {
  id             Int                        @id @default(autoincrement())
  channelId      Int?                       @map("channel_id")
  ownerKey       String                     @map("owner_key")
  scope          WhatsappCloudTemplateScope
  type           TemplateType
  variant        String                     @default("LEGACY")
  templateName   String                     @map("template_name")
  templateId     String?                    @map("template_id")
  category       String?                    @map("category")
  languageCode   String                     @default("es_MX") @map("language_code")
  status         String                     @default("PENDING")
  parameterNames Json                       @map("parameter_names")
  contentHash    String                     @map("content_hash")
  lastError      String?                    @map("last_error")
  lastSyncedAt   DateTime?                  @map("last_synced_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  channel        WhatsappChannel?           @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([ownerKey, scope, type, variant, contentHash])
  @@index([channelId, status])
  @@map("whatsapp_cloud_template_candidates")
}

model ShippingZone {
  id       Int          @id @default(autoincrement())
  name     String       @map("state")
  zoneType ShippingType @default(STANDARD) @map("zone_type")
  active   Boolean      @default(true) @map("active")

  @@map("shipping_zones")
}

model ExtraCharge {
