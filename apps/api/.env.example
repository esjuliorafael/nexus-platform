PORT=3001
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Store Database (PostgreSQL)
DATABASE_URL="postgresql://nexus:nexus_dev_password@localhost:5434/nexus_store_db"

# Raffle Database & Feature Flag
RAFFLE_ENABLED=true
RAFFLE_DATABASE_URL="postgresql://nexus:nexus_dev_password@localhost:5433/nexus_raffle_db"

# BullMQ Redis
REDIS_URL="redis://localhost:6379"

# Mercado Pago embedded checkout (the Public Key is safe to expose to the browser)
MP_PUBLIC_KEY="APP_USR-your-public-key"
MP_EMBEDDED_CHECKOUT_ENABLED=true
# Límite interno antes de cancelar un pago que Mercado Pago no ha resuelto.
MP_PAYMENT_PROCESSING_MAX_MINUTES=120
# Keep disabled until both recovery templates are configured and approved.
PAYMENT_RECOVERY_ENABLED=false
PAYMENT_RECOVERY_DELAY_SECONDS=90

# Evolution runs in Docker locally and must call the host through this address.
EVOLUTION_WEBHOOK_BASE_URL=http://host.docker.internal:3001

# Kapso gateway and local pilot. Keep automatic delivery on Evolution until
# every required Meta template has been approved for the channel's WABA.
KAPSO_WEBHOOK_BASE_URL=
KAPSO_PILOT_ENABLED=false
KAPSO_DELIVERY_ENABLED=false
KAPSO_API_KEY=""
KAPSO_PHONE_NUMBER_ID=""
KAPSO_BUSINESS_ACCOUNT_ID=""
KAPSO_WEBHOOK_SECRET=""
KAPSO_PLATFORM_WEBHOOK_SECRET=""
KAPSO_API_BASE_URL="https://api.kapso.ai"
# Meta resumable-upload handle used to submit the rich raffle invitation template.
KAPSO_RAFFLE_INVITATION_HEADER_HANDLE=
